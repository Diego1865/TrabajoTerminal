APP_DOMAIN=REEMPLAZAR_IP.sslip.io
GOOGLE_CLOUD_PROJECT=trabajoterminal-510019
# Generar valores nuevos en el servidor. No reutilizar los secretos locales.
SECRET_KEY=
# Cloud SQL: IP privada de la instancia y contraseña del usuario sqlserver
# (las llena deploy/cargar-sql.sh desde el secreto grafia-sql de Secret Manager)
DB_SERVER=
DB_PASSWORD=
GOOGLE_VISION_ENABLED=true
GOOGLE_VISION_LANGUAGE_HINTS=
# Cuenta de Gmail para los códigos (la llena deploy/cargar-correo.sh desde Secret Manager)
SMTP_USER=
SMTP_PASSWORD=
