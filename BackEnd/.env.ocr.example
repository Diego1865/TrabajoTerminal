# Agregar al .env existente del backend, conservando las variables de BD y JWT.
GOOGLE_VISION_ENABLED=true
# Opcional si ya usas gcloud auth application-default login en este entorno.
# GOOGLE_APPLICATION_CREDENTIALS=/ruta/privada/credenciales-google.json
# Idioma de la escritura. Vacío = es (español). "auto" deja que Vision lo adivine, pero con
# letra infantil puede devolver otro alfabeto. Varios: es,en
GOOGLE_VISION_LANGUAGE_HINTS=es
