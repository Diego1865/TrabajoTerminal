# Agregar al .env existente del backend, conservando las variables de BD y JWT.
GOOGLE_VISION_ENABLED=false
# Opcional con ADC local; en despliegue, ruta de credencial montada fuera del código.
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-vision.json
# Vacío: autodetección. Usar es solo si las pruebas justifican forzar esa pista.
GOOGLE_VISION_LANGUAGE_HINTS=
